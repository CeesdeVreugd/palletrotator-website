---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamPortretten from '../components/TeamPortretten.astro';
import { lang } from '../data/i18n';

const title = 'Offerte aanvragen PalletRotator | Brochure downloaden';
const description = 'Vraag een vrijblijvende offerte of brochure aan voor de PalletRotator palletkantelaar. Geef aan welk model, aantal en temperatuurbereik u nodig heeft.';
---
<BaseLayout title={title} description={description} path="/offerte-aanvragen/">
  <section class="dark-band title-band">
    <img class="title-shape" src="/images/logo-mark-shape.png" alt="" aria-hidden="true" width="1000" height="766" />
    <div class="wrap title-inner">
      <nav class="breadcrumb"><a href="/">Home</a> <span>/</span> <span class="current">Offerte aanvragen</span></nav>
      <span class="eyebrow">Offerte &amp; brochure</span>
      <h1>Vraag een vrijblijvende offerte aan</h1>
      <p>Laat hieronder uw gegevens achter en we sturen u een vrijblijvende prijsopgave. Wilt u een demonstratie? Vermeld dit in het formulier, dan nemen we contact op.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact-grid">
      <div class="card form-card">
        <form class="form-grid" id="offerte-form">
          <div class="form-field">
            <label for="naam">Naam*</label>
            <input type="text" id="naam" name="naam" required />
          </div>
          <div class="form-field">
            <label for="bedrijf">Bedrijfsnaam</label>
            <input type="text" id="bedrijf" name="bedrijf" />
          </div>
          <div class="form-field">
            <label for="telefoon">Telefoonnummer*</label>
            <input type="tel" id="telefoon" name="telefoon" required />
          </div>
          <div class="form-field">
            <label for="email">E-mailadres*</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-field full">
            <label for="model">Welk model heeft uw voorkeur?</label>
            <select id="model" name="model">
              <option value="std">PalletRotator</option>
              <option value="ept">PalletRotator EPT</option>
              <option value="both">Beide / weet ik nog niet</option>
            </select>
          </div>
          <div class="form-field">
            <label for="aantal">Aantal PalletRotators</label>
            <select id="aantal" name="aantal">
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3-5">3 tot 5</option>
              <option value="6+">6 of meer</option>
            </select>
          </div>
          <div class="form-field">
            <label for="temperatuur">Temperatuur op locatie</label>
            <select id="temperatuur" name="temperatuur">
              <option value="normal">5°C tot 40°C</option>
              <option value="frozen">-25°C tot 40°C (vrieshuis)</option>
            </select>
          </div>
          <div class="form-field full">
            <label for="opmerking">Opmerking / vraag om demonstratie</label>
            <textarea id="opmerking" name="opmerking" rows="4"></textarea>
          </div>
          <!-- Honeypot: voor mensen onzichtbaar, bots vullen dit in -->
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" id="t" name="t" value="" />
          <input type="hidden" name="taal" value={lang} />

          <div class="form-field full consent">
            <label class="check">
              <input type="checkbox" id="nieuwsbrief" name="nieuwsbrief" />
              <span>Houd mij af en toe op de hoogte van de PalletRotator (niet verplicht, afmelden kan altijd).</span>
            </label>
          </div>
          <p class="full form-note">We gebruiken uw gegevens alleen om uw aanvraag te beantwoorden. Zie de <a href="https://devreugd-pt.nl/privacyverklaring/" target="_blank" rel="noopener">privacyverklaring</a>.</p>

          <p id="offerte-error" class="form-error full" role="alert" hidden></p>

          <div class="form-field full">
            <button type="submit" class="btn btn-primary" id="offerte-submit" style="width:100%;">Offerte aanvragen</button>
          </div>
          <noscript><p class="full">Zonder JavaScript werkt dit formulier niet. Mail naar <a href="mailto:info@palletrotator.nl">info@palletrotator.nl</a>.</p></noscript>
        </form>

        <div id="offerte-done" class="offerte-done" hidden>
          <div class="done-icon" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <h2 class="done-h">Bedankt voor uw aanvraag!</h2>
          <p>We hebben uw gegevens ontvangen en nemen zo snel mogelijk contact met u op, meestal binnen één werkdag.</p>
          <a href="/brochure/" class="btn btn-outline" style="margin-top:10px;">Brochure downloaden</a>
        </div>
      </div>

      <div class="contact-side">
        <div class="card contact-info">
          <h3>Liever direct contact?</h3>
          <a href="tel:+31488412828">+31 (0)488 412 828</a>
          <a href="mailto:info@palletrotator.nl">info@palletrotator.nl</a>
          <p style="margin-top:14px;" translate="no">Edisonring 11<br />NL-6669 NA, Dodewaard</p>
        </div>
        <div class="card contact-info">
          <h3>Brochure downloaden</h3>
          <p>Download direct de uitgebreide PalletRotator-brochure met alle technische informatie en mogelijkheden.</p>
          <a href="/brochure/" class="btn btn-outline" style="margin-top:10px;">Brochure downloaden</a>
        </div>
      </div>
    </div>
  </section>

  <TeamPortretten />
</BaseLayout>

<script>
  import { msgs } from '../data/formtext';
  const form = document.getElementById('offerte-form') as HTMLFormElement | null;
  if (form) {
    const done = document.getElementById('offerte-done') as HTMLElement;
    const err = document.getElementById('offerte-error') as HTMLElement;
    const btn = document.getElementById('offerte-submit') as HTMLButtonElement;
    (document.getElementById('t') as HTMLInputElement).value = String(Date.now());
    const M = msgs();
    const fail = (msg: string) => { err.textContent = msg; err.hidden = false; btn.disabled = false; btn.textContent = M.quoteBtn; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, any>;
      data.nieuwsbrief = (document.getElementById('nieuwsbrief') as HTMLInputElement).checked;
      if (!String(data.naam || '').trim()) return fail(M.name);
      if (!String(data.telefoon || '').trim()) return fail(M.phone);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(data.email || '').trim())) return fail(M.email);
      btn.disabled = true; btn.textContent = M.busy;
      try {
        const r = await fetch('/api/offerte', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) return fail(j.error || M.fail);
        form.hidden = true; done.hidden = false;
        done.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        fail(`${M.offline} ${M.mail}.`);
      }
    });
  }
</script>

<style>
  .contact-grid { display: flex; gap: 40px; align-items: flex-start; }
  .form-card { flex: 1.4; max-width: none; }
  .contact-side { flex: 1; display: flex; flex-direction: column; gap: 20px; }
  .contact-info { padding: 28px; }
  .contact-info h3 { font-size: 16px; margin-bottom: 12px; }
  .contact-info a { display: block; margin-bottom: 6px; font-weight: 600; }
  .contact-info p { font-size: 13.5px; }
  /* .form-grid zet display:grid en overschrijft anders het hidden-attribuut */
  #offerte-form[hidden], .offerte-done[hidden], .form-error[hidden] { display: none !important; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .consent .check { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; font-size: 13.5px; line-height: 1.5; color: var(--ink); cursor: pointer; }
  .consent .check input { width: 18px; height: 18px; margin-top: 3px; flex: 0 0 18px; accent-color: var(--blue); }
  .form-note { font-size: 13px; color: var(--gray); margin: 0; }
  .form-note a { color: var(--blue); font-weight: 600; }
  .form-error { grid-column: 1 / -1; color: #B00020; font-size: 14px; font-weight: 600; margin: 0; }
  .full { grid-column: 1 / -1; }
  .offerte-done { text-align: center; padding: 12px 0; }
  .done-icon { width: 64px; height: 64px; border-radius: 50%; background: var(--blue); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
  .done-h { font-size: 22px; margin: 0 0 8px; }
  @media (max-width: 980px) {
    .contact-grid { flex-direction: column; }
  }
</style>
