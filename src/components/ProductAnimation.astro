---
interface Props {
  frames: string[];
  alt: string;
  /** ms per frame */
  interval?: number;
}
const { frames, alt, interval = 1100 } = Astro.props;
---
<div class="product-anim" data-interval={interval}>
  {frames.map((src, i) => (
    <img
      src={src}
      alt={i === 0 ? alt : ''}
      class={`anim-frame${i === 0 ? ' active' : ''}`}
      loading={i === 0 ? 'eager' : 'lazy'}
      decoding="async"
    />
  ))}
</div>

<style>
  .product-anim {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    min-height: 260px;
    border-radius: 20px;
    overflow: hidden;
    background: #EEF1FB;
  }
  .anim-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .anim-frame.active { opacity: 1; }
</style>

<script>
  function initProductAnimations() {
    var containers = document.querySelectorAll('.product-anim');

    containers.forEach(function (container) {
      var frames = container.querySelectorAll('.anim-frame');
      if (frames.length < 2) return;

      var interval = parseInt(container.getAttribute('data-interval'), 10) || 1100;
      var current = 0;

      setInterval(function () {
        var next = (current + 1) % frames.length;
        frames[current].classList.remove('active');
        frames[next].classList.add('active');
        current = next;
      }, interval);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductAnimations);
  } else {
    initProductAnimations();
  }
</script>
