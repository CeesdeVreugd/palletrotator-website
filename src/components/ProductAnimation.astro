---
interface Props {
  frames: string[];
  alt: string;
  /** ms per frame */
  interval?: number;
}
const { frames, alt, interval = 1100 } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---
<div class="product-anim" data-anim={uid} data-interval={interval}>
  {frames.map((src, i) => (
    <img
      src={src}
      alt={i === 0 ? alt : ''}
      class="anim-frame"
      class:list={[{ active: i === 0 }]}
      loading={i === 0 ? 'eager' : 'lazy'}
      decoding="async"
    />
  ))}
</div>

<style>
  .product-anim {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 20px;
    overflow: hidden;
    background: #EEF1FB;
  }
  .anim-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .anim-frame.active { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .anim-frame { transition: none; }
  }
</style>

<script>
  const containers = document.querySelectorAll<HTMLElement>('.product-anim');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  containers.forEach((container) => {
    const frames = Array.from(container.querySelectorAll<HTMLImageElement>('.anim-frame'));
    if (frames.length < 2 || prefersReducedMotion) return;

    const interval = Number(container.dataset.interval) || 1100;
    let current = 0;
    let timer: number | undefined;

    const advance = () => {
      const next = (current + 1) % frames.length;
      frames[current].classList.remove('active');
      frames[next].classList.add('active');
      current = next;
    };

    const start = () => {
      if (timer) return;
      timer = window.setInterval(advance, interval);
    };
    const stop = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    // Pauzeer buiten beeld (performance) en on hover (rustig kijken)
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
      { threshold: 0.15 }
    );
    io.observe(container);

    container.addEventListener('mouseenter', stop);
    container.addEventListener('mouseleave', () => {
      if (container.getBoundingClientRect().top < window.innerHeight) start();
    });
  });
</script>
