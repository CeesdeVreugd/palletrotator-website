---
import { team } from '../data/team';
const { lang = 'nl' } = Astro.props as { lang?: 'nl' | 'de' };
const tx = lang === 'de'
  ? { eyebrow: 'Ihre Ansprechpartner', titel: 'Lernen Sie das Team kennen', intro: 'Bei PalletRotator sprechen Sie direkt mit den Menschen, die die Maschine entwickeln, bauen und liefern.' }
  : { eyebrow: 'Uw aanspreekpunten', titel: 'Maak kennis met het team', intro: 'Bij PalletRotator spreekt u direct met de mensen die de machine bedenken, bouwen en leveren.' };
---
<section class="section team-section" aria-labelledby="team-titel">
  <div class="wrap">
    <div class="team-head">
      <span class="eyebrow">{tx.eyebrow}</span>
      <h2 id="team-titel">{tx.titel}</h2>
      <p class="team-intro">{tx.intro}</p>
    </div>
    <ul class="team-grid">
      {team.map((p) => (
        <li class="team-card">
          <img
            src={`/images/team/${p.slug}-800.webp`}
            srcset={`/images/team/${p.slug}-400.webp 400w, /images/team/${p.slug}-800.webp 800w`}
            sizes="(max-width: 800px) 90vw, 400px"
            alt={`${p.naam}, ${lang === 'de' ? p.functieDe : p.functie}`}
            width="800" height="800" loading="lazy"
          />
          <div class="team-text">
            <h3>{p.naam}</h3>
            <p class="team-role">{lang === 'de' ? p.functieDe : p.functie}</p>
            <a class="team-link" href={`tel:${p.tel.replace(/[^+\d]/g, '')}`}>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h3.5l1.7 4.3-2.2 1.4a11 11 0 0 0 5.3 5.3l1.4-2.2L20 14.5V18a2 2 0 0 1-2 2A14 14 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
              <span>{p.tel}</span>
            </a>
            <a class="team-link" href={`mailto:${p.email}`}>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg>
              <span>{p.email}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team-section { background: var(--bg-soft); }
  .team-head { text-align: center; max-width: 640px; margin: 0 auto 40px; }
  .team-intro { color: var(--gray); margin-top: 10px; }
  .team-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .team-card { background: #fff; box-shadow: 0 2px 10px rgba(10, 10, 80, 0.07); overflow: hidden; }
  .team-card img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; object-position: center 22%; }
  .team-text { padding: 24px 26px 26px; }
  .team-text h3 { font-size: 24px; color: var(--navy); margin: 0 0 4px; }
  .team-role { color: var(--gray); font-size: 14px; margin: 0 0 18px; }
  .team-link { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; font-size: 14.5px; font-weight: 600; color: var(--ink); }
  .team-link svg { color: var(--blue); flex: none; }
  .team-link:hover { color: var(--blue); }
  @media (max-width: 900px) {
    .team-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
  }
</style>
