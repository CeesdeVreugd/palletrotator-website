---
const nav = [
  { href: '/palletrotator/', label: 'Product' },
  { href: '/specificaties/', label: 'Standaard vs. EPT' },
  { href: '/vrieshuis-palletkantelaar/', label: 'Vrieshuis-uitvoering' },
  { href: '/toepassingen/', label: 'Toepassingen' },
  { href: '/referenties/', label: 'Referenties' },
];
---
<div class="topbar">
  <div class="wrap topbar-inner">
    <span class="topbar-brand">
      PalletRotator is een merk van&nbsp;<a href="https://devreugd-pt.nl" target="_blank" rel="noopener">De Vreugd Productietechniek</a>
    </span>
    <span class="topbar-contact">
      <a href="tel:+31488412828">+31 (0)488 412 828</a>
      <a href="mailto:info@palletrotator.nl">info@palletrotator.nl</a>
    </span>
  </div>
</div>

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <img src="/images/logo-mark-blue.png" alt="PalletRotator beeldmerk" class="brand-mark" />
      <span class="brand-text">
        <span class="brand-name">PalletRotator<em>.</em></span>
        <span class="brand-sub">Powered by De Vreugd</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Hoofdmenu">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a href="/offerte-aanvragen/" class="btn btn-primary btn-cta">Offerte aanvragen</a>

    <button class="menu-toggle" aria-label="Menu openen" aria-expanded="false" id="menu-toggle">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0A0A96" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobiel menu">
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <a href="/offerte-aanvragen/" class="btn btn-primary" style="margin-top:8px;">Offerte aanvragen</a>
  </nav>
</header>

<style>
  .topbar {
    background: var(--navy);
    padding: 9px 0;
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: #C9D2FF;
  }
  .topbar-brand a { color: #FFFFFF; font-weight: 700; }
  .topbar-contact { display: flex; gap: 22px; }
  .topbar-contact a { color: #C9D2FF; }

  .site-header {
    background: #FFFFFF;
    border-bottom: 1px solid var(--border-2);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .brand { display: flex; align-items: stretch; gap: 10px; }
  .brand-mark { display: block; height: 100%; width: auto; align-self: stretch; }
  .brand-text { display: flex; flex-direction: column; justify-content: space-between; line-height: 1.05; }
  .brand-name { font-weight: 700; font-size: 21px; color: var(--navy); }
  .brand-name em { color: var(--blue); font-style: normal; }
  .brand-sub { font-weight: 500; font-size: 10px; letter-spacing: 1.4px; color: #8890B5; text-transform: uppercase; }

  .main-nav { display: flex; gap: 30px; }
  .main-nav a { color: var(--ink); font-weight: 500; font-size: 14.5px; }
  .main-nav a:hover { color: var(--blue); }

  .btn-cta { padding: 11px 22px; font-size: 14px; white-space: nowrap; }

  .menu-toggle {
    display: none;
    background: var(--bg-soft);
    border: none;
    border-radius: 10px;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 24px 20px;
    border-top: 1px solid var(--border-2);
  }
  .mobile-nav a { padding: 10px 0; font-weight: 500; color: var(--ink); }
  .mobile-nav.open { display: flex; }

  @media (max-width: 980px) {
    .main-nav, .btn-cta { display: none; }
    .menu-toggle { display: flex; }
    .topbar-contact { display: none; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
