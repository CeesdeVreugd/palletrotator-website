---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<div class="faq-list">
  {items.map((i, n) => (
    <details class="faq-item" open={n === 0}>
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 820px; margin-top: 8px; }
  .faq-item { background: #fff; border: 1px solid #DCE3F5; border-radius: 12px; padding: 0 22px; }
  .faq-item summary { cursor: pointer; list-style: none; padding: 18px 28px 18px 0; font-weight: 700; color: var(--navy); font-size: 16px; position: relative; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 22px; color: var(--blue); font-weight: 400; }
  .faq-item[open] summary::after { content: "\2212"; }
  .faq-item p { padding: 0 0 20px; color: var(--gray); font-size: 15px; line-height: 1.65; }
</style>
