---
import { whatsappUrl, whatsappTexts, type WaLang } from '../data/contact';
const { lang = 'nl' } = Astro.props as { lang?: WaLang };
const url = whatsappUrl(lang);
const t = whatsappTexts[lang];
---
{url && (
  <a class="wa-float" href={url} target="_blank" rel="noopener" aria-label={t.aria} translate="no" data-keep-url>
    <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" fill="#fff">
      <path d="M16.02 3C8.84 3 3.01 8.83 3.01 16c0 2.29.6 4.52 1.74 6.49L3 29l6.68-1.72A13 13 0 0 0 16.02 29C23.2 29 29 23.17 29 16S23.2 3 16.02 3zm0 23.8c-1.95 0-3.86-.53-5.53-1.52l-.4-.24-3.96 1.02 1.06-3.86-.26-.4A10.76 10.76 0 0 1 5.2 16c0-5.96 4.86-10.8 10.82-10.8S26.8 10.04 26.8 16 21.98 26.8 16.02 26.8zm5.93-8.08c-.32-.16-1.92-.95-2.22-1.06-.3-.11-.51-.16-.73.16-.22.32-.84 1.06-1.03 1.28-.19.22-.38.24-.7.08-.32-.16-1.37-.5-2.6-1.6-.96-.86-1.6-1.91-1.8-2.23-.19-.32-.02-.5.14-.66.14-.14.32-.38.49-.57.16-.19.22-.32.32-.54.11-.22.05-.4-.03-.57-.08-.16-.73-1.76-1-2.4-.26-.63-.53-.54-.73-.55h-.62c-.22 0-.57.08-.87.4-.3.32-1.14 1.11-1.14 2.7 0 1.6 1.17 3.14 1.33 3.36.16.22 2.3 3.5 5.57 4.91.78.34 1.38.54 1.86.69.78.25 1.49.21 2.05.13.63-.09 1.92-.78 2.19-1.54.27-.76.27-1.4.19-1.54-.08-.14-.3-.22-.62-.38z"/>
    </svg>
    <span class="wa-label">{t.label}</span>
  </a>
)}

<style>
  .wa-float {
    position: fixed; right: 20px; bottom: 20px; z-index: 50;
    display: inline-flex; align-items: center; gap: 10px;
    height: 56px; padding: 0 16px; border-radius: 28px;
    background: #25D366; color: #fff; font-weight: 700; font-size: 15px;
    box-shadow: 0 6px 18px rgba(10, 10, 60, 0.28);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .wa-float:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(10, 10, 60, 0.34); color: #fff; }
  .wa-float:focus-visible { outline: 3px solid var(--navy); outline-offset: 3px; }
  @media (max-width: 640px) {
    .wa-label { display: none; }
    .wa-float { width: 56px; padding: 0; justify-content: center; right: 14px; bottom: 14px; }
  }
</style>
