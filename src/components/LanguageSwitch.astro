---
import { LANGS, lang, sites, switchUrl } from '../data/i18n';
import Flag from './Flag.astro';
// Astro.url.pathname is in elke taalbuild het Nederlandse bronpad; switchUrl vertaalt dat per taal.
const rawPath = Astro.url.pathname;
const nlPath = rawPath.endsWith('/') ? rawPath : rawPath + '/';
const { class: cls = '' } = Astro.props;
---
<ul class={`lang-switch ${cls}`} translate="no" aria-label="Language">
  {LANGS.map((l) => (
    <li>
      {l === lang
        ? <span class="lang-current" aria-current="true" lang={l}><Flag code={l} />{sites[l].label}</span>
        : <a href={switchUrl(nlPath, l)} data-keep-url hreflang={l} lang={l} title={sites[l].name} rel="alternate"><Flag code={l} />{sites[l].label}</a>}
    </li>
  ))}
</ul>

<style>
  .lang-switch { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; font-size: 12.5px; font-weight: 700; letter-spacing: .4px; }
  .lang-switch a, .lang-switch .lang-current { display: flex; align-items: center; gap: 6px; padding: 3px 7px; border-radius: 6px; }
  .lang-switch a { color: #C9D2FF; }
  .lang-switch a:hover { color: #FFFFFF; background: rgba(255,255,255,.12); }
  .lang-switch .lang-current { background: #FFFFFF; color: var(--navy); }
  .lang-switch.on-light a { color: var(--gray); }
  .lang-switch.on-light a:hover { color: var(--navy); background: var(--bg-soft); }
  .lang-switch.on-light .lang-current { background: var(--navy); color: #FFFFFF; }
</style>
