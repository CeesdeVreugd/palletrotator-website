---
import { klanten } from '../data/klanten';
interface Props { size?: 'sm' | 'lg'; }
const { size = 'sm' } = Astro.props;
---
<ul class={`klant-logos klant-logos-${size}`}>
  {klanten.map((k) => (
    <li>
      <img src={`/images/klanten/${k.slug}.png`} alt={`Logo ${k.name}`} width={k.w} height={k.h} loading="lazy" decoding="async" />
    </li>
  ))}
</ul>

<style>
  .klant-logos { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .klant-logos li {
    background: #fff; border: 1px solid var(--border-2, #E3E7F5); border-radius: 16px;
    display: flex; align-items: center; justify-content: center; padding: 14px 16px; height: 96px;
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  .klant-logos li:hover { border-color: var(--blue); box-shadow: 0 10px 26px rgba(10,10,150,0.10); transform: translateY(-2px); }
  .klant-logos img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .klant-logos-lg { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .klant-logos-lg li { height: 130px; padding: 20px 24px; }
  @media (max-width: 980px) { .klant-logos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .klant-logos, .klant-logos-lg { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .klant-logos li, .klant-logos-lg li { height: 88px; }
  }
</style>
