---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
}

const { title, description, path = '/', ogImage = '/images/og-palletrotator.jpg' } = Astro.props;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0A0A96" />
  <link rel="icon" type="image/png" href="/images/logo-mark-blue.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="PalletRotator" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="nl_NL" />
  <meta name="twitter:card" content="summary_large_image" />

  <slot name="head" />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
