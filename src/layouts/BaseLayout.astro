---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';
import { sites, LANGS, lang, urlFor } from '../data/i18n';

export interface Props {
  title: string;
  description: string;
  /** Pad van de Nederlandse bronpagina; de taalversies krijgen hun eigen URL via i18n/slugs.json */
  path?: string;
  ogImage?: string;
}

// Cookieloze bezoekstatistieken (Umami, eigen server). Alleen actief als UMAMI_URL en UMAMI_ID bij de build zijn ingesteld.
const umamiUrl = ((typeof process !== 'undefined' && process.env.UMAMI_URL) || '').replace(/\/$/, '');
const umamiId = (typeof process !== 'undefined' && process.env.UMAMI_ID) || '';
const umamiDomains = LANGS.flatMap((l) => { const h = new URL(sites[l].origin).hostname; return [h, h.replace(/^www\./, '')]; }).join(',');

const { title, description, path = '/', ogImage = '/images/og-palletrotator.jpg' } = Astro.props;
const canonical = urlFor(path, lang);
const site = sites[lang];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={urlFor(path, l)} />)}
  <link rel="alternate" hreflang="x-default" href={urlFor(path, 'nl')} />
  <meta name="theme-color" content="#0A0A96" />
  <link rel="icon" type="image/png" href="/images/logo-mark-blue.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="PalletRotator" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={site.locale} />
  <meta name="twitter:card" content="summary_large_image" />

  {umamiUrl && umamiId && <script is:inline defer src={`${umamiUrl}/script.js`} data-website-id={umamiId} data-domains={umamiDomains} data-do-not-track="true"></script>}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'PalletRotator',
    url: site.origin,
    logo: `${site.origin}/images/logo-mark-blue.png`,
    email: site.email,
    sameAs: ['https://www.linkedin.com/showcase/palletrotator/'],
    parentOrganization: { '@type': 'Organization', name: 'De Vreugd Productietechniek', url: 'https://devreugd-pt.nl' },
  })} />
  <slot name="head" />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <WhatsAppButton lang={lang} />
</body>
</html>
